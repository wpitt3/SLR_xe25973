	file = {PDF:/Users/willpitt/Zotero/storage/KSV2TJBF/Li et al. - 2025 - KD-MSLRT Lightweight Sign Language Recognition Model Based on Mediapipe and 3D to 1D Knowledge Dist.pdf:application/pdf},
