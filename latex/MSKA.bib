	keywords = {Computer Science - Machine Learning, Computer Science - Computation and Language, Computer Science - Artificial Intelligence},
	file = {PDF:/Users/willpitt/Zotero/storage/7L4J45ZI/Kim et al. - 2024 - SignBLEU Automatic Evaluation of Multi-channel Sign Language Translation.pdf:application/pdf},
