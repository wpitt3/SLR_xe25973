	doi = {10.1109/CVPR46437.2021.00137},
	abstract = {Despite existing pioneering works on sign language translation ({SLT}), there is a non-trivial obstacle, i.e., the limited quantity of parallel sign-text data. To tackle this parallel data bottleneck, we propose a sign back-translation ({SignBT}) approach, which incorporates massive spoken language texts into {SLT} training. With a text-to-gloss translation model, we ﬁrst back-translate the monolingual text to its gloss sequence. Then, the paired sign sequence is generated by splicing pieces from an estimated gloss-to-sign bank at the feature level. Finally, the synthetic parallel data serves as a strong supplement for the end-to-end training of the encoder-decoder {SLT} framework.},
